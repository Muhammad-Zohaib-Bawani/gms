# Frontend build-time config. Vite inlines these at BUILD time — changing them on a
# running container or App Service has no effect, the image has to be rebuilt.
# Copy to .env for local dev.

# Dev only: proxy target for /api/* and /realtimehub (vite forwards to the .NET API).
VITE_BACKEND_ORIGIN=https://localhost:7186

# Absolute API base URL including /api, or leave empty to call /api on this origin
# (which is what the vite dev proxy serves, see vite.config.js).
VITE_API_URL=
VITE_API_TIMEOUT=20000

# ── Portal sign-in ──────────────────────────────────────────────────────────
# entra = Microsoft Entra ID SSO, local = email + password.
# Must match the backend's Auth:Mode: with EntraId the API refuses portal password
# logins, so a 'local' frontend against an 'EntraId' backend cannot sign anyone in.
# Guests and drivers are unaffected — both sign in on their own apps with an
# emailed one-time code, whatever this says.
VITE_AUTH_MODE=local

# App registration values. Public identifiers, not secrets.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
# Defaults to api://{VITE_ENTRA_CLIENT_ID}/access_as_user — set this only if the
# exposed scope was given a different name.
VITE_ENTRA_SCOPE=
