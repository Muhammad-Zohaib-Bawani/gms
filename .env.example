# Copy to .env for local dev. .env is gitignored.

# Dev-only: vite dev server proxies /api/* to this backend origin (avoids CORS).
VITE_BACKEND_ORIGIN=https://api-uat-auc.kiahf.com

# API base URL the app calls (read at BUILD time by Vite).
#   Dev  : "/api"  -> goes through the proxy above.
#   Prod : full backend URL incl. /api, e.g. https://your-backend-host/api
# On Vercel: set VITE_API_URL in Project Settings > Environment Variables
# (Production scope) and redeploy — Vite inlines it at build time.
VITE_API_URL=/api
